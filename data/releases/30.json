{"id":30,"vendor_key":"qwen","vendor_name_zh":"通义千问","title":"[HF] Qwen/SAE-Res-Qwen3.5-27B-W80K-L0_100","url":"https://huggingface.co/Qwen/SAE-Res-Qwen3.5-27B-W80K-L0_100","source_type":"hf_api","published_at":"2026-04-27T03:39:43+00:00","detected_at":"2026-08-31T02:54:23Z","is_major":true,"trigger_status":"confirmed","official_benchmarks":[],"self_evals":[],"related_papers":[],"summary":{"summary_zh":"Qwen 团队发布 Qwen-Scope 可解释性工具套件，本次放出基于 Qwen3.5-27B 训练的残差流稀疏自编码器（SAE）检查点 SAE-Res-Qwen3.5-27B-W80K-L0_100。该 TopK SAE 宽度为 81920（16 倍扩展因子），每次前向仅保留 100 个非零特征，覆盖模型全部 64 层残差流，可自动提取高度解耦、低冗余、可解释性强的特征。Qwen-Scope 不仅可用于分析 Qwen 模型行为的内部机制，还支持可控推理控制、评测样本分布分析、数据分类与合成、模型训练优化等应用场景。这是面向 Qwen3/Qwen3.5 系列的可解释性基础设施发布，属于新工具类别而非新一代基座模型。","innovations":[{"dimension":"architecture","title":"全层覆盖的 TopK 稀疏自编码器","detail":"SAE 宽度 81920（16× 扩展），Top-K=100，挂载残差流，覆盖 0–63 共 64 层，每层提供独立检查点文件"},{"dimension":"inference","title":"可解释性驱动的模型分析与控制工具","detail":"基于稀疏特征支持可控推理控制、评测样本分布分析与比较、数据分类与合成、模型训练与优化等应用"}],"progress_magnitude":"moderate","progress_note":"这是 Qwen 首个覆盖 Qwen3/Qwen3.5 系列全层残差流的 SAE 可解释性工具发布，属于新型基础设施而非模型能力迭代","predecessor":null,"source_urls":["https://huggingface.co/Qwen/SAE-Res-Qwen3.5-27B-W80K-L0_100","https://qianwen-res.oss-accelerate.aliyuncs.com/qwen-scope/Qwen_Scope.pdf","https://arxiv.org/abs/2605.11887"],"confidence":"high","generated_by":"glm_anthro:glm-5.3","generated_at":"2026-09-01T07:58:39Z"},"model_specs":{"params_billions":27.0,"active_params_billions":null,"architecture":null,"num_experts":null,"context_window":null,"max_output":null,"modalities":["text"],"weights":"open","license":"qwen"},"training":{"pretrain_tokens_trillions":null,"data_mix":null,"compute":null,"pretrain_innovations":[],"posttrain_innovations":[],"rl_methods":[]},"pricing":{"has_pricing":false,"input_per_m":null,"output_per_m":null,"cached_in_per_m":null,"currency":"USD","effective_date":null},"content_sources":[{"kind":"primary","source":"https://huggingface.co/Qwen/SAE-Res-Qwen3.5-27B-W80K-L0_100","chars":600